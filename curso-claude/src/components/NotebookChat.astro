---
// src/components/NotebookChat.astro
---

<div class="max-w-4xl mx-auto my-12 bg-carbon-900 border border-carbon-800 rounded-xl overflow-hidden shadow-2xl flex flex-col h-[600px] font-sans">
  <!-- Header -->
  <div class="bg-carbon-950 px-6 py-4 border-b border-carbon-800 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-full bg-amber-500/10 flex items-center justify-center text-amber-500">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
        </svg>
      </div>
      <div>
        <h3 class="text-white font-medium">NotebookLM Assistant</h3>
        <p class="text-xs text-carbon-400">Pregunta sobre los apuntes del curso</p>
      </div>
    </div>
    <div class="text-xs px-2 py-1 bg-carbon-800 text-carbon-300 rounded-md">Powered by Gemini</div>
  </div>

  <!-- Messages Area -->
  <div id="chat-messages" class="flex-1 overflow-y-auto p-6 space-y-6 bg-carbon-900/50">
    <!-- Initial welcome message -->
    <div class="flex gap-4">
      <div class="w-8 h-8 rounded-full bg-amber-500/20 flex-shrink-0 flex items-center justify-center text-amber-500 mt-1">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m3 21 1.9-5.7a8.5 8.5 0 1 1 3.8 3.8z"></path>
        </svg>
      </div>
      <div class="bg-carbon-800 border border-carbon-700 text-carbon-200 rounded-2xl rounded-tl-none px-5 py-3.5 max-w-[85%] prose prose-invert prose-sm">
        <p>¡Hola! Soy tu asistente de estudio. He analizado todos los apuntes y manuales del curso Claude 101. ¿Qué te gustaría saber?</p>
      </div>
    </div>
  </div>

  <!-- Input Area -->
  <div class="p-4 bg-carbon-950 border-t border-carbon-800">
    <form id="chat-form" class="relative flex items-center">
      <input 
        type="text" 
        id="chat-input"
        class="w-full bg-carbon-900 border border-carbon-700 text-white rounded-full pl-5 pr-12 py-3 focus:outline-none focus:border-amber-500/50 focus:ring-1 focus:ring-amber-500/50 transition-all placeholder-carbon-500"
        placeholder="Ej: ¿Cuáles son las mejores técnicas de prompting?"
        required
      />
      <button 
        type="submit" 
        id="chat-submit"
        class="absolute right-2 w-9 h-9 rounded-full bg-amber-500 hover:bg-amber-400 flex items-center justify-center text-carbon-950 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m22 2-7 20-4-9-9-4Z"></path>
          <path d="M22 2 11 13"></path>
        </svg>
      </button>
    </form>
  </div>
</div>

<script>
  import { marked } from 'marked';
  import DOMPurify from 'dompurify';

  const form = document.getElementById('chat-form') as HTMLFormElement;
  const input = document.getElementById('chat-input') as HTMLInputElement;
  const submitBtn = document.getElementById('chat-submit') as HTMLButtonElement;
  const messagesContainer = document.getElementById('chat-messages');

  function addMessage(content: string, isUser: boolean = false) {
    if (!messagesContainer) return;
    
    const div = document.createElement('div');
    div.className = `flex gap-4 ${isUser ? 'flex-row-reverse' : ''}`;
    
    const avatar = document.createElement('div');
    avatar.className = `w-8 h-8 rounded-full flex-shrink-0 flex items-center justify-center mt-1 ${
      isUser ? 'bg-carbon-700 text-white' : 'bg-amber-500/20 text-amber-500'
    }`;
    
    avatar.innerHTML = isUser 
      ? '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>'
      : '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 21 1.9-5.7a8.5 8.5 0 1 1 3.8 3.8z"></path></svg>';

    const messageBubble = document.createElement('div');
    messageBubble.className = `px-5 py-3.5 max-w-[85%] prose prose-invert prose-sm ${
      isUser 
        ? 'bg-amber-500 text-carbon-950 rounded-2xl rounded-tr-none prose-p:text-carbon-950' 
        : 'bg-carbon-800 border border-carbon-700 text-carbon-200 rounded-2xl rounded-tl-none'
    }`;
    
    // Parse markdown if it's the bot, otherwise just text
    if (isUser) {
      messageBubble.textContent = content;
    } else {
      const parsedHtml = marked.parse(content) as string;
      messageBubble.innerHTML = DOMPurify.sanitize(parsedHtml);
    }

    div.appendChild(avatar);
    div.appendChild(messageBubble);
    messagesContainer.appendChild(div);
    
    // Scroll to bottom
    messagesContainer.scrollTop = messagesContainer.scrollHeight;
  }

  function addLoader() {
    if (!messagesContainer) return null;
    
    const id = 'loader-' + Date.now();
    const div = document.createElement('div');
    div.id = id;
    div.className = 'flex gap-4';
    
    div.innerHTML = `
      <div class="w-8 h-8 rounded-full bg-amber-500/20 flex-shrink-0 flex items-center justify-center text-amber-500 mt-1">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="animate-spin">
          <path d="M21 12a9 9 0 1 1-6.219-8.56"></path>
        </svg>
      </div>
      <div class="bg-carbon-800 border border-carbon-700 rounded-2xl rounded-tl-none px-5 py-3.5 flex items-center gap-1.5 h-[52px]">
        <div class="w-2 h-2 rounded-full bg-carbon-500 animate-pulse"></div>
        <div class="w-2 h-2 rounded-full bg-carbon-500 animate-pulse" style="animation-delay: 150ms"></div>
        <div class="w-2 h-2 rounded-full bg-carbon-500 animate-pulse" style="animation-delay: 300ms"></div>
      </div>
    `;
    
    messagesContainer.appendChild(div);
    messagesContainer.scrollTop = messagesContainer.scrollHeight;
    
    return id;
  }

  function removeLoader(id: string) {
    const loader = document.getElementById(id);
    if (loader) loader.remove();
  }

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const message = input.value.trim();
      if (!message) return;
      
      // Reset input
      input.value = '';
      submitBtn.disabled = true;
      input.disabled = true;
      
      // Show user message
      addMessage(message, true);
      
      // Show loader
      const loaderId = addLoader();
      
      try {
        const response = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message })
        });
        
        const data = await response.json();
        
        if (loaderId) removeLoader(loaderId);
        
        if (!response.ok) {
          throw new Error(data.error || 'Error en la petición');
        }
        
        addMessage(data.response);
        
      } catch (error: any) {
        if (loaderId) removeLoader(loaderId);
        addMessage(`*Error:* ${error.message}. Por favor, verifica que la API Key está configurada correctamente en el archivo .env.`);
      } finally {
        submitBtn.disabled = false;
        input.disabled = false;
        input.focus();
      }
    });
  }
</script>
