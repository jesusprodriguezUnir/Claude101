</html>

<style is:global>
  /* === Selection === */
  ::selection {
    background: rgba(217, 119, 6, 0.3);
    color: #fff;
  }

  /* === Custom Scrollbar === */
  ::-webkit-scrollbar {
    width: 6px;
  }
  ::-webkit-scrollbar-track {
    background: #0c0c0c;
  }
  ::-webkit-scrollbar-thumb {
    background: #2a2a2a;
    border-radius: 3px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: #3a3a3a;
  }

  /* === Smooth scroll === */
  html {
    scroll-behavior: smooth;
  }

  /* === Staggered animation delays === */
  .stagger-1 { animation-delay: 0.1s; }
  .stagger-2 { animation-delay: 0.2s; }
  .stagger-3 { animation-delay: 0.3s; }
  .stagger-4 { animation-delay: 0.4s; }
  .stagger-5 { animation-delay: 0.5s; }
  .stagger-6 { animation-delay: 0.6s; }

  /* === Terminal dots === */
  .terminal-dots::before {
    content: '';
    display: inline-flex;
    gap: 6px;
    width: 48px;
    height: 12px;
    background: 
      radial-gradient(circle at 6px 6px, #f87171 4px, transparent 4px),
      radial-gradient(circle at 22px 6px, #facc15 4px, transparent 4px),
      radial-gradient(circle at 38px 6px, #4ade80 4px, transparent 4px);
  }

  /* === Details marker removal === */
  details summary::-webkit-details-marker,
  details summary::marker {
    display: none;
    content: '';
  }

  /* === Glow card effect === */
  .glow-card {
    position: relative;
    transition: all 0.3s ease;
  }
  .glow-card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    opacity: 0;
    transition: opacity 0.3s ease;
    box-shadow: 0 0 24px rgba(217, 119, 6, 0.1), inset 0 0 0 1px rgba(217, 119, 6, 0.15);
    pointer-events: none;
  }
  .glow-card:hover::after {
    opacity: 1;
  }
  .glow-card:hover {
    border-color: rgba(217, 119, 6, 0.2) !important;
    transform: translateY(-2px);
  }

  /* === Intersection Observer fade-in === */
  .observe-fade {
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .observe-fade.visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  // Intersection Observer for scroll animations
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
  );

  document.querySelectorAll('.observe-fade').forEach((el) => {
    observer.observe(el);
  });
</script>